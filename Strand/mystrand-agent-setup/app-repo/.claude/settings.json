{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Edit(./policy/rules.yaml)",
      "Edit(./policy/no-fly.yaml)",
      "Edit(./policy/threat-model.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./policy/rules.yaml)",
      "Write(./policy/no-fly.yaml)",
      "Write(./policy/threat-model.md)",
      "Write(./.claude/**)",
      "Write(./.github/**)",
      "Write(./AGENTS.md)",
      "Write(./CLAUDE.md)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(kubectl *)",
      "Bash(terraform apply *)",
      "Bash(psql *)"
    ],
    "ask": [
      "Bash(git push *)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ]
  }
}
